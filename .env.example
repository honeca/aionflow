# Supabase Configuration
# Obtenha estas credenciais em: https://app.supabase.com/project/_/settings/api

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (anon/public) do Supabase
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# =====================================================
# INSTRUÇÕES:
# =====================================================
# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Preencha as variáveis com seus valores reais do Supabase
#
# 3. Nunca compartilhe o arquivo .env (ele já está no .gitignore)
# =====================================================
